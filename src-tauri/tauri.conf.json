{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PaddleBai",
  "version": "1.0.0",
  "identifier": "com.paddlenabai.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 3102",
    "devUrl": "http://localhost:3102",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaddleBai",
        "width": 1280,
        "height": 850,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
